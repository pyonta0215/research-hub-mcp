{
  "name": "research-hub-mcp",
  "version": "0.1.0",
  "description": "MCP server for AI-driven research: unified search/trending/get_item across Hacker News, arXiv, and RSS feeds",
  "type": "module",
  "bin": {
    "research-hub-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib": {
      "types": "./dist/services/research.d.ts",
      "default": "./dist/services/research.js"
    },
    "./schema": {
      "types": "./dist/core/schema.d.ts",
      "default": "./dist/core/schema.js"
    },
    "./config/feeds.json": "./config/feeds.json"
  },
  "files": [
    "dist",
    "config/feeds.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyonta0215/research-hub-mcp.git"
  },
  "author": "pyonta0215",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "research",
    "hacker-news",
    "arxiv",
    "rss"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
